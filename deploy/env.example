# Template for GitHub Actions secret DEPLOY_DOTENV (full file, multiline).
# GitHub Actions deploy secrets: SSH_HOST, SSH_USER, SSH_PASSWORD (password auth only).
# On the server, /etc/ssh/sshd_config should allow PasswordAuthentication yes and sshd reloaded.
# Replace OWNER/REPO with your GitHub org/user and repo name (lowercase for GHCR).
# Image tag is often "latest" after a successful Docker publish on the default branch.

APIGATEWAY_IMAGE=ghcr.io/OWNER/REPO/apigateway:latest
APIGATEWAY_PORT=8080
AUTHSERVICE_IMAGE=ghcr.io/OWNER/REPO/authservice:latest
AUTHSERVICE_PORT=8080
BASKETSERVICE_IMAGE=ghcr.io/OWNER/REPO/basketservice:latest
BASKETSERVICE_PORT=8080
DELIVERYSERVICE_IMAGE=ghcr.io/OWNER/REPO/deliveryservice:latest
DELIVERYSERVICE_PORT=8080
ECOMMERCE_WEB_IMAGE=ghcr.io/OWNER/REPO/ecommerce-web:latest
ORDERSERVICE_IMAGE=ghcr.io/OWNER/REPO/orderservice:latest
ORDERSERVICE_PORT=8080
PRODUCTSERVICE_IMAGE=ghcr.io/OWNER/REPO/productservice:latest
PRODUCTSERVICE_PORT=8080

ELASTICSEARCH_PASSWORD=change-me
# Required. Must match the password Postgres was first initialized with (see below).
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# HMAC signing key: Auth issues JWTs; ApiGateway validates. Same value, at least 32 characters (use a long random string).
JWT_KEY=change-me-to-a-secret-at-least-32-characters-long

# Reverse proxy TLS: nginx mounts this host directory (PEMs as fullchain.pem + privkey.pem).
# Relative to the directory that holds docker-compose.yaml on the server.
REVERSE_PROXY_BINDMOUNT=./ssl
#
# GitHub Actions deploy-compose workflow: add repository secrets (Settings > Secrets > Actions):
#   REVERSE_PROXY_SSL_FULLCHAIN_PEM   — full text of the public certificate / chain (Cloudflare Origin or LE)
#   REVERSE_PROXY_SSL_PRIVATE_KEY_PEM  — full text of the matching private key
# The workflow writes them into ./ssl/ in the bundle before rsync (nothing committed). Manual deploy: copy PEMs to ./ssl on the server yourself.
# Open host TCP 443. Cloudflare SSL/TLS: Full or Full (strict). Visitors still use Cloudflare edge certs.
# Add DNS A/AAAA for aspire.ugurdemir.dev (Aspire Dashboard via nginx → compose-dashboard:18888); include it in the origin cert SANs if not using a wildcard.

# --- Postgres 28P01 (password authentication failed) ---
# Deploy merges this file over Aspire’s published .env; you must set POSTGRES_PASSWORD here.
# If you change POSTGRES_PASSWORD after Postgres has already created its data volume, the old
# password remains inside the volume. Fix: stop the stack, remove the postgres volume, then up again
# (this wipes DBs). Example: docker compose down && docker volume ls | grep postgres
# then docker volume rm <name> (or docker compose down -v if acceptable).
