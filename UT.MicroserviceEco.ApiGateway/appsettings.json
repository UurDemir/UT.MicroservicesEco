{
  "Jwt": {
    "Issuer": "UT.MicroserviceEco.AuthService",
    "Audience": "UT.MicroserviceEco.ApiGateway"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-register-route": {
        "ClusterId": "auth-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/register",
          "Methods": [ "POST" ]
        }
      },
      "auth-authenticated-route": {
        "ClusterId": "auth-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminOnly"
      },
      "products-get-list-route": {
        "ClusterId": "product-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/products",
          "Methods": [ "GET" ]
        }
      },
      "products-get-by-id-route": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/products/{id}",
          "Methods": [ "GET" ]
        }
      },
      "products-post-route": {
        "ClusterId": "product-cluster",
        "Order": 5,
        "Match": {
          "Path": "/api/products",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "products-mutate-route": {
        "ClusterId": "product-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "baskets-get-route": {
        "ClusterId": "basket-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/baskets/{userName}",
          "Methods": [ "GET" ]
        }
      },
      "baskets-mutate-route": {
        "ClusterId": "basket-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/baskets/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "orders-get-list-route": {
        "ClusterId": "order-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/orders",
          "Methods": [ "GET" ]
        }
      },
      "orders-get-by-id-route": {
        "ClusterId": "order-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/orders/{id}",
          "Methods": [ "GET" ]
        }
      },
      "orders-post-route": {
        "ClusterId": "order-cluster",
        "Order": 5,
        "Match": {
          "Path": "/api/orders",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "orders-mutate-route": {
        "ClusterId": "order-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "deliveries-get-list-route": {
        "ClusterId": "delivery-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/deliveries",
          "Methods": [ "GET" ]
        }
      },
      "deliveries-get-by-order-route": {
        "ClusterId": "delivery-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/deliveries/order/{orderId}",
          "Methods": [ "GET" ]
        }
      },
      "deliveries-post-route": {
        "ClusterId": "delivery-cluster",
        "Order": 5,
        "Match": {
          "Path": "/api/deliveries",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "deliveries-mutate-route": {
        "ClusterId": "delivery-cluster",
        "Order": 10,
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://authservice"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://productservice"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://basketservice"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://orderservice"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "https+http://deliveryservice"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
